# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────
# STREAMLIT COMMUNITY CLOUD — Secret Store Template
# ─────────────────────────────────────────────────────────────
# When deploying to https://streamlit.io/cloud:
#   1. Go to App Settings → Secrets
#   2. Paste the content below with your real API keys
#   3. The app auto-detects cloud mode and reads from st.secrets
#
# DO NOT commit secrets.toml to GitHub — it is .gitignored.
# ─────────────────────────────────────────────────────────────

GROQ_API_KEY = "gsk_your_groq_key_here"
GEMINI_API_KEY = ""          # Optional — leave blank to skip Gemini
LLM_PROVIDER = "groq"
DATASET_ANCHOR_DATE = "2024-03-30 18:06"
