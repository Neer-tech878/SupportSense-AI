# ============================================================
# DOTMappers AI Assessment — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: .env is gitignored — your keys are never committed.
# ============================================================

# ── LLM Provider Selection ──────────────────────────────────
# Controls which provider is tried FIRST.
# Options: groq | gemini | ollama
# The cascade always falls back automatically: Groq → Gemini → Ollama
LLM_PROVIDER=groq

# ── Groq Cloud (PRIMARY — Recommended) ──────────────────────
# Free tier at: https://console.groq.com
# No credit card required.  ~30 RPM, sub-400ms latency.
GROQ_API_KEY=gsk_your_free_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (SECONDARY — Optional) ────────────────────
# Free tier at: https://aistudio.google.com
# If blank, the cascade silently skips Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Local Ollama (TERTIARY — Fully Offline) ─────────────────
# Runs on your NVIDIA GPU. No internet required.
# Start with: ollama run qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder-6gb

# ── Application Settings ────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501

# Dataset anchor date (dataset max timestamp — do not change)
DATASET_ANCHOR_DATE=2024-03-30 18:06
